# Environment variables the MQTT Intelligence MCP server reads.
#
# Copy to .env for your own use. This file is an example: it is committed, and .env is not.
# The server does not read .env itself — nothing here is loaded automatically. Export these,
# or put them in the "env" block of your MCP client's entry (see examples/mcp-clients).

# --- Choosing a configuration ----------------------------------------------------------------

# Path to the configuration file, used when --config is not passed.
MQTT_INTELLIGENCE_CONFIG=./examples/industrial-machine/mqtt-intelligence.yaml

# --- Or: the file-less quick start -------------------------------------------------------------
#
# Set MQTT_URL and no configuration file is needed at all. One broker, default policy, which
# means it may read everything: right for a first run on a laptop, wrong for anything else.

# MQTT_URL=mqtt://localhost:1883
# MQTT_BROKER_ID=factory-fr
# MQTT_USERNAME=mcp-reader
# MQTT_PASSWORD=

# --- Secrets referenced by the example configurations ---------------------------------------
#
# Configuration files reference secrets ({ env: MQTT_PASSWORD }) and never contain them, which
# is what lets them be committed. These are the names the examples use.

# MQTT_PASSWORD=
# MQTT_FR_PASSWORD=
# MQTT_DE_PASSWORD=
# MQTT_CLIENT_KEY_PASSPHRASE=

# --- The example simulator -----------------------------------------------------------------
#
# Read by examples/industrial-machine/docker-compose.yml.

# Seconds between two scripted incidents on the fictional line.
# SIMULATOR_INCIDENT_INTERVAL_SECONDS=180
# How long the line stays down.
# SIMULATOR_INCIDENT_DURATION_SECONDS=25
# Same seed, same numbers, every run.
# SIMULATOR_SEED=20260101
# Host port the example broker is published on. Change the url in the example configuration
# to match: a server that connects to the wrong broker reports no topics, not an error.
# MQTT_EXAMPLE_HOST_PORT=1883
