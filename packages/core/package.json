{
  "name": "@kadeya/mqtt-intelligence-core",
  "version": "0.2.0",
  "private": false,
  "description": "MQTT Intelligence engine: bounded discovery, topic catalog and safe payload views for MQTT infrastructures. Independent from MCP.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeyaorg/mqtt-intelligence-mcp.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mqtt",
    "mqtt-client",
    "iot",
    "iiot",
    "industrial-iot",
    "unified-namespace",
    "topic-discovery",
    "observability",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
