{
  "name": "@kadeya/mqtt-intelligence-mcp",
  "version": "0.2.0",
  "private": false,
  "description": "MCP server giving AI agents safe, structured and observable, read-only-by-default access to MQTT infrastructures.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeyaorg/mqtt-intelligence-mcp.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mqtt",
    "iot",
    "iiot",
    "industrial-iot",
    "ai-agents",
    "llm",
    "claude"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mqtt-intelligence-mcp": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@kadeya/mqtt-intelligence-core": "0.2.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  }
}
