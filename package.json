{
  "name": "mqtt-intelligence-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MQTT Intelligence MCP: give AI agents safe, structured and observable access to MQTT infrastructures.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeyaorg/mqtt-intelligence-mcp.git"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp-server",
    "examples/industrial-machine/simulator"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "node tools/setup-git-hooks.js",
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/mcp-server && tsc -p examples/industrial-machine/simulator",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project core --project mcp-server --project tools",
    "test:coverage": "vitest run --project core --project mcp-server --project tools --coverage",
    "test:coverage:core": "vitest run --project core --project core-integration --coverage --coverage.include=src/**/*.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:integration": "vitest run --project core-integration --project mcp-server-integration",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "3.9.9",
    "testcontainers": "^12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
