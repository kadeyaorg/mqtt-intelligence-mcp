{
  "name": "mqtt-intelligence-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MQTT Intelligence MCP: give AI agents safe, structured and observable access to MQTT infrastructures.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeyaorg/mqtt-intelligence-mcp.git"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp-server"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/mcp-server",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
